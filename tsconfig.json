{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"@/*": ["./web/src/*"]
		},
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"types": ["bun"]
	},
	"include": ["src", "scripts", "tests", "web/src", "web/vite.config.ts"]
}
