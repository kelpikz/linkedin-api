# Copy the full Cookie request header from a signed-in linkedin.com request.
LINKEDIN_COOKIE=

# Optional. If omitted, the app derives this from the JSESSIONID cookie.
LINKEDIN_CSRF_TOKEN=

# LinkedIn changes this periodically. Override it when a request starts failing.
LINKEDIN_APP_VERSION=0.2.6975

# Optional overrides from a recent browser request.
LINKEDIN_APPLICATION_INSTANCE=
LINKEDIN_X_LI_TRACK=
LINKEDIN_USER_AGENT=

# Bearer tokens for /api/*, separated by commas. Requests fail with 401 if empty.
API_KEYS=

PORT=3000

# Optional. Route LinkedIn calls through a residential proxy (T-06).
LINKEDIN_PROXY_URL=

# Caddy site address. A hostname turns on TLS. Use :80 for a local run.
SITE_ADDRESS=:80
